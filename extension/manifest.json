{
  "manifest_version": 3,
  "name": "GUGA Knowledge · 个人知识收件箱",
  "version": "0.9.1",
  "description": "快捷收集、离线整理，直接同步到自己的 Google Drive，随时导出备份。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "favicon",
    "identity"
  ],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 GUGA Knowledge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "start.html"
  },
  "options_page": "dashboard.html#settings",
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "保存选中文字或当前网页"
    },
    "dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "打开整理页"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https: http:; img-src 'self' data: blob: https: http:; media-src 'self' blob:; style-src 'self'; base-uri 'none'"
  },
  "optional_host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "464495637351-vaslclbq0t7oa5ratt3dchdv3t626dhu.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "key": "",
  "short_name": "GUGA Knowledge"
}
